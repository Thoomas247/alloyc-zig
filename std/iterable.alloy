// The iteration interface driving 'for' loops.
//
// Iterable is a lang item (LANGUAGE_SPEC.md section 5.1a) at the canonical
// path std::iterable::Iterable. Fixed arrays, slices, and heap arrays
// implement it implicitly with a compiler-provided 'length' (section 5.1);
// custom types implement it explicitly and additionally provide the cursor
// protocol ('iterator' and 'next', section 4.3) to become 'for' subjects.

pub interface Iterable {
    fn length() -> u64;
}
