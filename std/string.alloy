// The owned, growable byte string.
//
// A String owns a heap buffer of UTF-8 bytes and a count of the bytes in
// use. Growth follows the manual pattern of LANGUAGE_SPEC.md section 4.2
// with a doubling buffer, so appends are amortized constant. 'view'
// borrows the contents in place as a plain '&[u8]' slice, the type every
// text-taking function (and string literal) already uses.

import std::option;
import std::iterable;

pub type String : Iterable = struct {
    storage: Option<*var [u8]>,
    count: u64,
};

// A string with no bytes and no allocation.
pub fn String::empty() -> String {
    return String { .storage = ::None, .count = 0 };
}

// An owned copy of the given text.
pub fn String::from(text: &[u8]) -> String {
    var result = String::empty();
    result.append(text);
    return result;
}

// The number of bytes in use (the Iterable requirement).
pub fn length(self string: &String) -> u64 {
    return string.count;
}

// Borrows the contents in place. The view is invalidated by the next
// mutation (growth may reallocate), like any Alloy reference.
pub fn view(self string: &String) -> &[u8] {
    if (string.storage is ::Some) |buffer: &| {
        return buffer[..string.count];
    }
    return "";
}

// Appends one byte.
pub fn push(self string: &var String, byte: u8) {
    string.ensure_capacity(string.count + 1);
    if (string.storage is ::Some) |buffer: &var| {
        buffer[string.count] = byte;
    }
    string.count += 1;
}

// Appends every byte of the given text.
pub fn append(self string: &var String, text: &[u8]) {
    string.ensure_capacity(string.count + text.length());
    if (string.storage is ::Some) |buffer: &var| {
        var cursor = string.count;
        for (text) |byte| {
            buffer[cursor] = byte;
            cursor += 1;
        }
    }
    string.count += text.length();
}

// Appends the decimal digits of the value. The most negative i64 cannot
// be negated and faults in checked builds.
pub fn append_integer(self string: &var String, value: i64) {
    if (value < 0) {
        string.push('-');
        string.append_integer(-value);
        return;
    }
    if (value >= 10) {
        string.append_integer(value / 10);
    }
    string.push('0' + (value % 10) to u8);
}

// Empties the string; the buffer is kept for future appends.
pub fn clear(self string: &var String) {
    string.count = 0;
}

// True when the contents equal the given text byte for byte.
pub fn equals(self string: &String, text: &[u8]) -> bool {
    return text_equals(string.view(), text);
}

// True when two byte sequences match exactly.
pub fn text_equals(left: &[u8], right: &[u8]) -> bool {
    if (left.length() != right.length()) {
        return false;
    }
    for (left, right) |a, b| {
        if (a != b) {
            return false;
        }
    }
    return true;
}

// Grows the buffer to hold at least 'needed' bytes, copying the bytes
// in use across; reassigning the owning field reclaims the old buffer.
fn ensure_capacity(self string: &var String, needed: u64) {
    var current: u64 = 0;
    if (string.storage is ::Some) |buffer: &| {
        current = buffer.length();
    }
    if (needed <= current) {
        return;
    }
    var grown_capacity = current * 2;
    if (grown_capacity < 16) {
        grown_capacity = 16;
    }
    if (grown_capacity < needed) {
        grown_capacity = needed;
    }
    var grown: *var [u8] = new [0 : grown_capacity];
    if (string.storage is ::Some) |buffer: &| {
        for ([..string.count]) |index| {
            grown[index] = buffer[index];
        }
    }
    string.storage = ::Some(move grown);
}
