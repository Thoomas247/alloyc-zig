// growable array placeholder; the real implementation arrives with the
// standard library work (LANGUAGE_SPEC.md section 4.2, Growth is manual)
import std::iterable;

pub type Vec<T> : Iterable = struct {
    items: *[T],
    count: u64,
};

pub fn length<T>(self v: &Vec<T>) -> u64 {
    return v.count;
}
